{
	log default {
		exclude http.log.error
	}
}

{$APP_HOST} {
	request_header -X-Forwarded-*
	request_header -X-Proxied-Https
	request_header -Proxy-SSL-ID
	request_header -Proxy-Auth-Cert
	reverse_proxy 127.0.0.1:18083 {
		header_up Forwarded "proto=https;host={$APP_HOST}"
		header_up Host {$APP_HOST}
	}
}
