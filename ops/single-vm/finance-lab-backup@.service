[Unit]
Description=Finance Lab database backup (%i)
Wants=network-online.target
After=network-online.target postgresql@18-main.service

[Service]
Type=oneshot
User=finance_backup
EnvironmentFile=/etc/finance-lab/backup.env
UMask=0077
StateDirectory=finance-lab-backup
StateDirectoryMode=0700
RuntimeDirectory=finance-lab-backup-%i
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock /var/lib/finance-lab-backup/job.lock /usr/local/libexec/finance-lab/backup %i
ExecStopPost=/usr/local/libexec/finance-lab/report-backup %i
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
